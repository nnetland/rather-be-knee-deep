# macOS
.DS_Store

# Throwaway preview builds — a copy of the app with the clock frozen and the
# weather API stubbed, generated so seasonal features can be reviewed out of
# season. Never deploy one of these.
*-DEMO.html

# Local test output
screenshots/
screenshots-quiver/

# Files moved aside for manual deletion (this session cannot delete on disk)
_to_delete/

# Built bundles — generated by build.py and rebuilt by GitHub Actions on every
# push to main, so tracking them only produces enormous conflicting diffs when
# more than one session is open at once. Both still appear on disk locally;
# rather-be-knee-deep.html is the standalone file for local preview.
/public/index.html
/rather-be-knee-deep.html
